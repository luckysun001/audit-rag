# 配置文件

# 复制此文件为 .env 并修改相应配置

# ============================================================================
# 基础配置
# ============================================================================
ATRAG_ENVIRONMENT=development
ATRAG_PROJECT_NAME="Audit RAG"
ATRAG_LOG_LEVEL=INFO
ATRAG_LOG_JSON_FORMAT=false

# ============================================================================
# API 服务配置
# ============================================================================
ATRAG_API_HOST=0.0.0.0
ATRAG_API_PORT=8080
ATRAG_API_WORKERS=4
ATRAG_API_RELOAD=true
ATRAG_API_CORS_ORIGINS=["http://localhost:8501"]
ATRAG_API_RATE_LIMIT=100/minute

# ============================================================================
# LLM 配置
# ============================================================================
ATRAG_LLM_PROVIDER=openai
ATRAG_LLM_MODEL=gpt-4o
ATRAG_LLM_TEMPERATURE=0.0
ATRAG_LLM_MAX_TOKENS=4096
ATRAG_LLM_TIMEOUT=120
ATRAG_LLM_MAX_RETRIES=3

# OpenAI 配置
ATRAG_OPENAI_API_KEY=your_openai_api_key_here
# ATRAG_OPENAI_BASE_URL=
# ATRAG_OPENAI_ORGANIZATION=

# Azure OpenAI 配置
# ATRAG_AZURE_OPENAI_API_KEY=
# ATRAG_AZURE_OPENAI_ENDPOINT=
# ATRAG_AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ============================================================================
# Embedding 配置
# ============================================================================
ATRAG_EMBEDDING_PROVIDER=openai
ATRAG_EMBEDDING_MODEL=text-embedding-3-large
ATRAG_EMBEDDING_DIMENSION=3072
ATRAG_EMBEDDING_BATCH_SIZE=32

# ============================================================================
# 向量数据库配置
# ============================================================================
ATRAG_VECTOR_STORE_TYPE=chroma
ATRAG_VECTOR_STORE_COLLECTION=audit_documents
ATRAG_VECTOR_STORE_PERSIST_DIR=./data/chroma

# Chroma 配置
ATRAG_CHROMA_HOST=localhost
ATRAG_CHROMA_PORT=8000
ATRAG_CHROMA_SSL=false

# ============================================================================
# 检索配置
# ============================================================================
ATRAG_RETRIEVER_TYPE=hybrid
ATRAG_RETRIEVER_TOP_K=5
ATRAG_RETRIEVER_SCORE_THRESHOLD=0.7
ATRAG_RETRIEVER_ENABLE_RERANK=true
ATRAG_RETRIEVER_RERANK_TOP_N=3

# ============================================================================
# 文档处理配置
# ============================================================================
ATRAG_DOCUMENT_CHUNK_SIZE=1000
ATRAG_DOCUMENT_CHUNK_OVERLAP=200
ATRAG_DOCUMENT_SPLITTER_TYPE=recursive

# 50MB
ATRAG_DOCUMENT_MAX_FILE_SIZE=52428800

# ============================================================================
# Redis 缓存配置
# ============================================================================
ATRAG_REDIS_URL=redis://localhost:6379/0
ATRAG_REDIS_CACHE_TTL=3600
ATRAG_REDIS_CACHE_ENABLED=true
ATRAG_REDIS_CACHE_PREFIX=at_rag

# ============================================================================
# 监控配置
# ============================================================================
ATRAG_METRICS_ENABLED=true
ATRAG_METRICS_PORT=9090
ATRAG_TRACING_ENABLED=false

# ============================================================================
# 安全配置
# ============================================================================
ATRAG_SECURITY_API_KEY_ENABLED=true
ATRAG_SECURITY_API_KEYS=["change-me-in-production"]
